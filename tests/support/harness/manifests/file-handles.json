{
  "version": 2,
  "suite": "file-handles",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 10
  },
  "tests": [
    {
      "name": "closed_alias_fclose",
      "source": "../../../cases/run/checked_closed_file_handle.hs",
      "stdin": "a",
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "closed file-handle use is undefined outside checked mode; compile only"
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "closed file-handle use is undefined outside checked mode; compile only"
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 120,
            "stdout": "",
            "stderr_regex": "^hitsimple runtime error: closed file handle at .*/checked_closed_file_handle\\.hs:[0-9]+:[0-9]+\\n$"
          }
        }
      }
    },
