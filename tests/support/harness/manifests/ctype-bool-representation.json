{
  "version": 1,
  "suite": "ctype-bool-representation",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 10
  },
  "tests": [
    {
      "name": "optimized",
      "source": "../../../cases/run/ctype_bool_representation.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect": {
        "compile": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "run": {
          "exit_code": 0,
          "stdout": "digit 0 0\nalpha 0 0\nalnum 0 0\nspace 0 0\ncontrols 0\n",
          "stderr": ""
        }
      }
    },
    {
      "name": "reference",
      "source": "../../../cases/run/ctype_bool_representation.hs",
      "compile_args": [
        "--stdlib-provider=reference"
      ],
      "expect": {
        "compile": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "run": {
          "exit_code": 0,
          "stdout": "digit 0 0\nalpha 0 0\nalnum 0 0\nspace 0 0\ncontrols 0\n",
          "stderr": ""
        }
      }
    }
  ]
}
