{
  "version": 2,
  "suite": "true-name-rebinding-runtime-errors",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "null_optimized",
      "source": "../../../cases/run/checked_rebinding_null.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 120,
            "stdout": "",
            "stderr_regex": "^hitsimple runtime error: null address at .*[/\\\\]checked_rebinding_null\\.hs:\\d+:\\d+\\r?\\n$"
          }
        }
      }
    },
