{
  "version": 2,
  "suite": "named-return-storage",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "optimized",
      "source": "../../../cases/run/named_return_storage.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        }
      }
    },
    {
      "name": "reference",
      "source": "../../../cases/run/named_return_storage.hs",
      "compile_args": [
        "--stdlib-provider=reference"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "views 0\\r?\\nscope 0\\r?\\nmethods 0\\r?\\n"
          }
        }
      }
    }
  ]
}
