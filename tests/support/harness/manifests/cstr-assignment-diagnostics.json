{
  "version": 2,
  "suite": "cstr-assignment-diagnostics",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "cstr_default_float_optimized",
      "source": "../../../cases/sema/cstr_default_float.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*cstr default assignment requires a cstr source View.*"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*cstr default assignment requires a cstr source View.*"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*cstr default assignment requires a cstr source View.*"
          }
        }
      }
    },
