{
  "version": 1,
  "suite": "explicit-numeric-returns",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "optimized",
      "source": "../../../cases/run/explicit_numeric_returns.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect": {
        "compile": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "run": {
          "exit_code": 0,
          "stdout": "booleans 0\nintegers 0\nfloats 0\nevaluation 0\n",
          "stderr": ""
        }
      }
    },
    {
      "name": "reference",
      "source": "../../../cases/run/explicit_numeric_returns.hs",
      "compile_args": [
        "--stdlib-provider=reference"
      ],
      "expect": {
        "compile": {
          "exit_code": 0,
          "stdout": "",
          "stderr": ""
        },
        "run": {
          "exit_code": 0,
          "stdout": "booleans 0\nintegers 0\nfloats 0\nevaluation 0\n",
          "stderr": ""
        }
      }
    }
  ]
}
