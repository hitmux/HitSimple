{
  "version": 2,
  "suite": "literal-ternary-rejections",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "length_optimized",
      "source": "../../../cases/sema/literal_ternary_length.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*ternary\\ branches\\ must\\ have\\ the\\ same\\ template\\ and\\ byte\\ length.*"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*ternary\\ branches\\ must\\ have\\ the\\ same\\ template\\ and\\ byte\\ length.*"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*ternary\\ branches\\ must\\ have\\ the\\ same\\ template\\ and\\ byte\\ length.*"
          }
        }
      }
    },
    {
      "name": "template_optimized",
