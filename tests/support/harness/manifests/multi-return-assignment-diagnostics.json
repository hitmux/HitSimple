{
  "version": 2,
  "suite": "multi-return-assignment-diagnostics",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "reject_float_integer_optimized",
      "source": "../../../cases/sema/multi_return_float_integer.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        }
      }
    },
    {
      "name": "reject_float_integer_reference",
      "source": "../../../cases/sema/multi_return_float_integer.hs",
      "compile_args": [
        "--stdlib-provider=reference"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 1,
            "stdout": "",
            "stderr_regex": "(?s).*right operand of '=' is not an integer expression.*"
          }
        }
      }
    }
  ]
}
