{
  "version": 2,
  "suite": "unsigned-snapshot-integration",
  "defaults": {
    "targets": [
      "host"
    ],
    "safety": [
      "unchecked",
      "static-checked",
      "checked"
    ],
    "optimization": [
      "O0",
      "O2"
    ],
    "timeout_seconds": 20
  },
  "tests": [
    {
      "name": "optimized",
      "source": "../../../cases/run/unsigned_snapshot_integration.hs",
      "compile_args": [
        "--stdlib-provider=optimized"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        }
      }
    },
    {
      "name": "reference",
      "source": "../../../cases/run/unsigned_snapshot_integration.hs",
      "compile_args": [
        "--stdlib-provider=reference"
      ],
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 0,
            "stderr": "",
            "stdout_regex": "unsigned integration 0\\r?\\n"
          }
        }
      }
    },
    {
      "name": "ternary_extent",
      "source": "../../../cases/run/unsigned_snapshot_ternary_extent.hs",
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "Invalid source read or interpretation is undefined outside checked mode."
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "Invalid source read or interpretation is undefined outside checked mode."
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 120,
            "stdout": "",
            "stderr_regex": "(?s).*invalid checked load.*"
          }
        }
      }
    },
    {
      "name": "ternary_lifetime",
      "source": "../../../cases/run/unsigned_snapshot_ternary_lifetime.hs",
      "expect_by_mode": {
        "unchecked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "Invalid source read or interpretation is undefined outside checked mode."
        },
        "static-checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run_not_applicable": "Invalid source read or interpretation is undefined outside checked mode."
        },
        "checked": {
          "compile": {
            "exit_code": 0,
            "stdout": "",
            "stderr": ""
          },
          "run": {
            "exit_code": 120,
            "stdout": "",
            "stderr_regex": "(?s).*invalid checked load.*"
          }
        }
      }
    }
  ]
}
